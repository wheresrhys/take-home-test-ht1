# Local-only docker Postgres credentials — throwaway values, safe to commit.
# Used by `npm run db:start` (docker-compose.yml) and admin-role test clients.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=take_home_admin
POSTGRES_PASSWORD=take_home_local_password
POSTGRES_DB=take_home_test

# pg-native names for the app's own connection (src/providers/postgres-client.ts).
# Same target as above — kept distinct from the POSTGRES_* admin vars above so the
# app's Pool config never accidentally reads admin credentials. There is no PGUSER:
# the app hardcodes user: "form_ingester" in code (see postgres-client.ts).
PGHOST=localhost
PGPORT=5432
PGDATABASE=take_home_test
FORM_INGESTER_DB_PASSWORD=ingesterpassword
