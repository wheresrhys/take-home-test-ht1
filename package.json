{
  "name": "take-home-test",
  "version": "1.0.0",
  "description": "Take home test project",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "DOTENV_CONFIG_PATH=.env.local node -r dotenv/config dist/index.js",
    "dev": "DOTENV_CONFIG_PATH=.env.local ts-node-dev --respawn -r dotenv/config src/index.ts",
    "test": "jest",
    "generate:schema": "ts-json-schema-generator --path src/forms/schemas/ingested_schema.ts --type IngestedFormSchema --no-top-ref -o src/forms/schemas/ingested_schema.schema.json",
    "db:start": "docker compose --env-file .env.local up -d && npm run db:apply-schema",
    "db:apply-schema": "./db/apply-schema.sh"
  },
  "keywords": [],
  "license": "ISC",
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.0.0",
    "ts-json-schema-generator": "^2.9.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "dotenv": "^17.4.2",
    "express": "^4.22.1"
  }
}
